    {
      "parameters": {
        "jsCode": "const flattened = [];\n\n// 1. Extraction des vidéos Pexels + choix du meilleur fichier vidéo max 1920x1080\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const videos = item.json.videos || [];\n\n  for (const v of videos) {\n    const files = (v.video_files || [])\n      .filter(f => f.link)\n      .filter(f => Number(f.width || 0) <= 1920)\n      .filter(f => Number(f.height || 0) <= 1080);\n\n    if (!files.length) continue;\n\n    const bestFile = files.sort((a, b) => {\n      const aw = Number(a.width || 0);\n      const bw = Number(b.width || 0);\n      const ah = Number(a.height || 0);\n      const bh = Number(b.height || 0);\n\n      if (bw !== aw) return bw - aw;\n      return bh - ah;\n    })[0];\n\n    flattened.push({\n      json: {\n        segment_index: i,\n        video_id: v.id,\n        duration: v.duration,\n        image: v.image,\n        video_url: bestFile.link || null,\n        width: bestFile.width || null,\n        height: bestFile.height || null\n      }\n    });\n  }\n}\n\n// 2. Scoring des clips\nfunction scoreItem(item) {\n  const d = Number(item.json.duration || 0);\n  const w = Number(item.json.width || 0);\n  const h = Number(item.json.height || 0);\n\n  let score = 0;\n\n  if (w > h) score += 2;\n\n  if (w >= 1920) score += 3;\n  else if (w >= 1280) score += 2;\n  else if (w >= 960) score += 1;\n\n  if (d >= 8 && d <= 20) score += 3;\n  else if (d >= 6) score += 2;\n  else if (d >= 4) score += 1;\n\n  return score;\n}\n\n// 3. Regroupement par segment\nconst groups = {};\n\nfor (const item of flattened) {\n  const key = Number(item.json.segment_index);\n\n  if (!groups[key]) groups[key] = [];\n\n  groups[key].push({\n    json: {\n      ...item.json,\n      score: scoreItem(item)\n    }\n  });\n}\n\n// 4. Sélection des meilleurs clips par segment\nconst keys = Object.keys(groups).map(Number).sort((a, b) => a - b);\nconst used = new Set();\nconst winners = [];\n\nconst minUsefulClipDuration = 2.5;\n\nfor (let idx = 0; idx < keys.length; idx++) {\n  const key = keys[idx];\n  let candidates = groups[key] || [];\n\n  if (!candidates.length) continue;\n\n  const wantedDuration = Number(candidates[0].json.segment_duration || 0);\n\n  const isNearEnd = idx >= keys.length - 2;\n  const maxClipsPerSegment = isNearEnd ? 6 : 4;\n  const targetCoverageFactor = isNearEnd ? 3.0 : 2.2;\n\n  const targetCoverage = Math.max(\n    wantedDuration * targetCoverageFactor,\n    wantedDuration + (isNearEnd ? 4 : 2)\n  );\n\n  candidates.sort((a, b) => {\n    if (b.json.score !== a.json.score) return b.json.score - a.json.score;\n    return Number(b.json.duration || 0) - Number(a.json.duration || 0);\n  });\n\n  let uniqueCandidates = candidates\n    .filter(v => !used.has(String(v.json.video_id)))\n    .filter(v => Number(v.json.duration || 0) >= minUsefulClipDuration);\n\n  let covered = 0;\n  let selectedForSegment = 0;\n\n  for (const candidate of uniqueCandidates) {\n    if (selectedForSegment >= maxClipsPerSegment) break;\n\n    winners.push({\n      json: {\n        video_url: candidate.json.video_url,\n        duration: candidate.json.duration\n      }\n    });\n\n    used.add(String(candidate.json.video_id));\n    covered += Number(candidate.json.duration || 0);\n    selectedForSegment += 1;\n\n    if (covered >= targetCoverage) break;\n  }\n\n  if (selectedForSegment === 0) {\n    const relaxed = candidates\n      .filter(v => Number(v.json.duration || 0) >= minUsefulClipDuration)\n      .slice(0, isNearEnd ? 3 : 2);\n\n    for (const candidate of relaxed) {\n      winners.push({\n        json: {\n          video_url: candidate.json.video_url,\n          duration: candidate.json.duration\n        }\n      });\n\n      selectedForSegment += 1;\n\n      if (selectedForSegment >= (isNearEnd ? 3 : 2)) break;\n    }\n  }\n\n  if (selectedForSegment === 0 && candidates.length > 0) {\n    winners.push({\n      json: {\n        video_url: candidates[0].json.video_url,\n        duration: candidates[0].json.duration\n      }\n    });\n  }\n}\n\nreturn winners;"
      },
