    {
      "parameters": {
        "jsCode": "const imageHost = $('DATA DEPART').first().json.image_host;\n\nconst output = [];\n\n// Host au début\noutput.push({\n  json: {\n    image: imageHost,\n  },\n});\n\n// Images des scènes\nfor (const item of items) {\n  const data = item.json.data;\n\n  if (!data?.resultJson) continue;\n\n  const parsedResult =\n    typeof data.resultJson === \"string\"\n      ? JSON.parse(data.resultJson)\n      : data.resultJson;\n\n  const resultUrls = parsedResult.resultUrls || [];\n\n  for (const url of resultUrls) {\n    output.push({\n      json: {\n        image: url,\n      },\n    });\n  }\n}\n\n// Host à la fin\noutput.push({\n  json: {\n    image: imageHost,\n  },\n});\n\nreturn output;"
