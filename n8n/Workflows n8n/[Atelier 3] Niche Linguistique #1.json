    {
      "parameters": {
        "jsonSchemaExample": "{\n      \"title\": \"A Quiet Evening at the Cafe\",\n      \"language\": \"English\",\n      \"level\": \"A1/A2\",\n\n      \"intro\": {\n        \"narration\": \"Welcome everyone. Today we will follow two friends during a quiet evening at a small cafe near the station...\",\n        \"image_prompt\": \"...\"\n      },\n\n      \"scenes\": [\n        {\n          \"scene_number\": 1,\n          \"scene_title\": \"Arriving at the Cafe\",\n          \"image_prompt\": \"...\",\n          \"dialogue\": [\n            {\n              \"speaker\": \"Sarah\",\n              \"line\": \"It feels colder today.\"\n            },\n            {\n              \"speaker\": \"Daniel\",\n              \"line\": \"Yes, but the cafe looks warm inside.\"\n            }\n          ]\n        }\n      ],\n\n      \"outro\": {\n        \"narration\": \"Thank you for listening today. We hope this small story helped you practice English in a calm and natural way...\",\n        \"image_prompt\": \"...\"\n      }\n    }",
        "autoFix": true
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2928,
        1584
      ],
      "id": "e3984ce6-ddcc-4fe9-8045-44cdfc48b34a",
      "name": "Structured Output Parser",
      "retryOnFail": true
    },
    {
      "parameters": {
        "fieldToSplitOut": "output.scenes",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        3072,
        1424
      ],
      "id": "7e731900-60fe-4a4d-8317-ce95eb62a308",
      "name": "Split Out"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nconst maleVoices = [\n  \"Callum\",\n  \"Roger\",\n  \"Charlie\",\n  \"George\",\n  \"River\",\n  \"Liam\",\n  \"Will\",\n  \"Eric\",\n  \"Chris\",\n  \"Brian\",\n  \"Daniel\",\n  \"Bill\"\n];\n\n// Récupère l'output complet de l'agent IA\nconst agentData = $('AI Agent').first().json;\n\n// Selon ta structure, l'output peut être directement dans agentData.output\nconst fullOutput = agentData.output || agentData;\n\nconst intro = fullOutput.intro;\nconst outro = fullOutput.outro;\n\n// Les scènes viennent des items splittés\nconst scenes = items.map(item => item.json);\n\n// Récupère les speakers déjà utilisés\nconst usedSpeakers = new Set();\n\nfor (const scene of scenes) {\n  if (!Array.isArray(scene.dialogue)) continue;\n\n  for (const dialogue of scene.dialogue) {\n    usedSpeakers.add(dialogue.speaker);\n  }\n}\n\n// Choisit une voix narrateur masculine non utilisée\nconst narratorVoice =\n  maleVoices.find(voice => !usedSpeakers.has(voice)) || \"Callum\";\n\n// INTRO\nif (intro?.narration) {\n  output.push({\n    json: {\n      type: \"intro\",\n      inputs: [\n        {\n          text: Array.isArray(intro.narration)\n            ? intro.narration.join(\" \")\n            : intro.narration,\n          voice: narratorVoice,\n        },\n      ],\n    },\n  });\n}\n\n// SCÈNES\nfor (const scene of scenes) {\n  if (!Array.isArray(scene.dialogue)) continue;\n\n  output.push({\n    json: {\n      type: \"scene\",\n      scene_number: scene.scene_number,\n      scene_title: scene.scene_title,\n      inputs: scene.dialogue.map(dialogue => ({\n        text: dialogue.line,\n        voice: dialogue.speaker,\n      })),\n    },\n  });\n}\n\n// OUTRO\nif (outro?.narration) {\n  output.push({\n    json: {\n      type: \"outro\",\n      inputs: [\n        {\n          text: Array.isArray(outro.narration)\n            ? outro.narration.join(\" \")\n            : outro.narration,\n          voice: narratorVoice,\n        },\n      ],\n    },\n  });\n}\n\nreturn output;"
      },
