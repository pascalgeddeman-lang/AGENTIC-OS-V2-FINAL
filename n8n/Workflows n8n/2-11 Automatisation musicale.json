      "parameters": {
        "jsCode": "const fps = 1;\nconst maxFrames = 1000;\n\nconst item = $input.first().json;\n\nconst duration = item.media.duration;\n\n// URL de l'image depuis le node \"On form submission\"\nconst imageUrl = $items(\"On form submission\")[0].json.Miniature;\n\nconst totalFrames = Math.ceil(duration * fps);\n\nconst images = [];\n\nlet remainingFrames = totalFrames;\n\nwhile (remainingFrames > 0) {\n  const frames = Math.min(remainingFrames, maxFrames);\n\n  images.push({\n    frames,\n    url: imageUrl\n  });\n\n  remainingFrames -= frames;\n}\n\nreturn [\n  {\n    json: {\n      images,\n      fps,\n      imageUrl\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
